{
  "name": "yellow-design",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "ts-node --project server/tsconfig.json server/index.ts",
    "server:dev": "ts-node --project server/tsconfig.json server/index.ts",
    "admin": "cd admin && npm run dev",
    "admin:build": "cd admin && npm run build",
    "web:build": "expo export --platform web --output-dir dist && node scripts/inject-web-hints.mjs",
    "web:deploy": "npm run web:build && firebase deploy --only hosting:yellow-design-app"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.3.0",
    "@expo-google-fonts/jetbrains-mono": "^0.3.0",
    "@expo-google-fonts/noto-sans-kannada": "^0.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.9.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
