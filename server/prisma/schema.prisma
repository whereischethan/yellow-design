generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  phone     String   @unique
  name      String?
  email     String?
  role      String   @default("rider")
  createdAt       String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("created_at")
  referralCode    String? @unique @map("referral_code")
  referredById    String? @map("referred_by_id")
  referralCredits Int     @default(0) @map("referral_credits")

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrals")

  refreshTokens RefreshToken[]
  bookings      Booking[]
  leads         Lead[]
  savedPlaces   SavedPlace[]

  @@index([referredById])
  @@map("users")
}

model OtpSession {
  id        String @id
  phone     String
  otp       String
  expiresAt BigInt @map("expires_at")
  verified  Int    @default(0)
  createdAt BigInt @default(0) @map("created_at")

  @@map("otp_sessions")
}

model RefreshToken {
  token     String @id
  userId    String @map("user_id")
  expiresAt BigInt @map("expires_at")
  createdAt BigInt @default(0) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Booking {
  id                  String  @id
  tripCode            String  @unique @map("trip_code")
  userId              String? @map("user_id")
  status              String  @default("confirmed")
  tripType            String? @map("trip_type")
  vehicleType         String? @default("yellowSky") @map("vehicle_type")
  price               Int?    @default(0)
  passengerCount      Int?    @default(1) @map("passenger_count")
  meetAndGreet        Int?    @default(0) @map("meet_and_greet")
  petFriendly         Int?    @default(0) @map("pet_friendly")
  pickupJson          String? @map("pickup_json")
  dropJson            String? @map("drop_json")
  flightJson          String? @map("flight_json")
  pricingJson         String? @map("pricing_json")
  guestName           String? @map("guest_name")
  guestPhone          String? @map("guest_phone")
  assignedDriverJson  String? @map("assigned_driver_json")
  assignedVehicleJson String? @map("assigned_vehicle_json")
  razorpayOrderId     String? @map("razorpay_order_id")
  razorpayPaymentId   String? @map("razorpay_payment_id")
  razorpayLinkId      String? @map("razorpay_link_id")
  razorpayLinkUrl     String? @map("razorpay_link_url")
  paymentStatus       String  @default("paid") @map("payment_status")
  paymentMethod       String? @map("payment_method")
  stopsJson           String? @map("stops_json")
  customerGstin       String? @map("customer_gstin")
  customerGstName     String? @map("customer_gst_name")
  sendSms             Boolean @default(true) @map("send_sms")
  driverCollect       Boolean @default(false) @map("driver_collect")
  createdAt           String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("created_at")

  user           User?           @relation(fields: [userId], references: [id])
  invoice        Invoice?
  customInvoices CustomInvoice[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("bookings")
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String   @unique  @map("invoice_no")
  bookingId   String   @unique  @map("booking_id")
  generatedAt DateTime @default(now()) @map("generated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model CustomInvoice {
  id              String   @id @default(cuid())
  invoiceNo       String   @unique @map("invoice_no")
  bookingId       String   @map("booking_id")
  customAmount    Int      @map("custom_amount")
  driverName      String?  @map("driver_name")
  vehiclePlate    String?  @map("vehicle_plate")
  customerName    String?  @map("customer_name")
  pickupLocation  String?  @map("pickup_location")
  dropLocation    String?  @map("drop_location")
  pickupDateTime  String?  @map("pickup_date_time")
  distanceKm      Float?   @map("distance_km")
  toll            Int?
  discount        Int?
  stopsJson       String?  @map("stops_json")
  note            String?
  generatedAt     DateTime @default(now()) @map("generated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("custom_invoices")
}

model InvoiceCounter {
  fy       String
  quarter  Int
  lastSeq  Int    @default(0) @map("last_seq")

  @@id([fy, quarter])
  @@map("invoice_counters")
}

model Driver {
  id          String  @id
  name        String
  phone       String  @unique
  status      String  @default("available")
  rating      Float   @default(5.0)
  plate       String?
  vehicle     String?
  joined      String?
  trips       Int     @default(0)
  docLicense  String? @map("doc_license")
  docAadhaar  String? @map("doc_aadhaar")
  docPan      String? @map("doc_pan")
  docPolice   String? @map("doc_police")
  licenseNo   String? @map("license_no")
  licenseExp  String? @map("license_exp")
  photoUrl    String? @map("photo_url")
  bankHolder  String? @map("bank_holder")
  bankIfsc    String? @map("bank_ifsc")
  bankAccount String? @map("bank_account")
  bankUpi     String? @map("bank_upi")

  vehicles Vehicle[]
  readings DriverReading[]
  location DriverLocation?

  @@map("drivers")
}

model DriverReading {
  id        String   @id @default(cuid())
  driverId  String   @map("driver_id")
  driver    Driver   @relation(fields: [driverId], references: [id])
  bookingId String?  @map("booking_id")
  type      String   // handoff | trip_start | trip_end | close_duty
  odometer  Float?
  soc       Float?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("driver_readings")
}

model Vehicle {
  id              String  @id
  plate           String  @unique
  make            String
  model           String
  color           String  @default("Yellow")
  type            String  @default("yellowSky")
  classKey        String  @default("yellowSky") @map("class_key")
  year            Int     @default(2024)
  status          String  @default("available")
  driverId        String? @map("driver_id")
  trips           Int     @default(0)
  isEv            Int     @default(1) @map("is_ev")
  soc             Int     @default(80)
  odometer        Int     @default(0)
  insuranceExpiry String? @map("insurance_expiry")
  fcExpiry        String? @map("fc_expiry")
  maintenanceNote String? @map("maintenance_note")

  driver Driver? @relation(fields: [driverId], references: [id])

  @@map("vehicles")
}

model Lead {
  id         String  @id
  userId     String  @map("user_id")
  status     String  @default("new")
  tripType   String? @map("trip_type")
  pickupJson String? @map("pickup_json")
  dropJson   String? @map("drop_json")
  price      Int?    @default(0)
  pickupTime String? @map("pickup_time")
  flight     String?
  quotedAt    String? @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("quoted_at")
  callerNote  String? @map("caller_note")
  tripCode    String? @map("trip_code")
  pricingJson String? @map("pricing_json")
  stopsJson   String? @map("stops_json")

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("leads")
}

model DriverLocation {
  driverId  String   @id @map("driver_id")
  lat       Float
  lng       Float
  heading   Float?
  speed     Float?
  updatedAt DateTime @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_locations")
}

model PushToken {
  token     String   @id
  ownerType String   @map("owner_type") // 'user' | 'driver'
  ownerId   String   @map("owner_id")
  platform  String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerType, ownerId])
  @@map("push_tokens")
}

model PricingConfig {
  key   String @id
  value String

  @@map("pricing_config")
}

model AdminUser {
  id        String  @id
  phone     String  @unique
  name      String?
  role      String  @default("ops")
  createdAt String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("created_at")

  @@map("admin_users")
}

model SavedPlace {
  id        String  @id
  userId    String  @map("user_id")
  label     String
  address   String
  placeId   String? @map("place_id")
  lat       Float?
  lng       Float?
  createdAt String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS')")) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_places")
}
